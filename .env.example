# Django Settings
SECRET_KEY=django-insecure-freelancer-hub-secret-key-change-in-production-2025
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Default SQLite for local dev, PostgreSQL for production)
USE_POSTGRES=False
POSTGRES_DB=freelancer_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Channels Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@freelancerhub.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Payment Configuration (Razorpay - India)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Cloud Storage (Optional Cloudinary / S3)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=placeholder_api_secret

# CORS / Frontend Domain
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
